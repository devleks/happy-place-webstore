# Systemd Service Unit for Happy Place Boutique Backend
# Gunicorn WSGI Server
#
# Installation:
# 1. Copy to: sudo cp happyplace-backend.service /etc/systemd/system/
# 2. Reload systemd: sudo systemctl daemon-reload
# 3. Enable on boot: sudo systemctl enable happyplace-backend
# 4. Start service: sudo systemctl start happyplace-backend
# 5. Check status: sudo systemctl status happyplace-backend
#
# Commands:
# - Start: sudo systemctl start happyplace-backend
# - Stop: sudo systemctl stop happyplace-backend
# - Restart: sudo systemctl restart happyplace-backend
# - Logs: sudo journalctl -u happyplace-backend -f

[Unit]
Description=Happy Place Boutique Backend (Gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/happyplace/backend
Environment="PATH=/var/www/happyplace/backend/venv/bin"
EnvironmentFile=/var/www/happyplace/backend/.env.production

# Gunicorn command
ExecStart=/var/www/happyplace/backend/venv/bin/gunicorn \
    --config gunicorn_config.py \
    --bind 127.0.0.1:5001 \
    --workers 4 \
    --worker-class sync \
    --timeout 30 \
    --access-logfile /var/log/happyplace/gunicorn-access.log \
    --error-logfile /var/log/happyplace/gunicorn-error.log \
    app:app

# Restart policy
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGQUIT
TimeoutStopSec=30

# Process limits
LimitNOFILE=4096
LimitNPROC=512

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=happyplace-backend

[Install]
WantedBy=multi-user.target
