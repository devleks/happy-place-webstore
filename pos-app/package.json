{
  "name": "happy-place-pos",
  "version": "1.0.0",
  "description": "Happy Place Boutique - Point of Sale Progressive Web App",
  "author": "Happy Place Boutique",
  "license": "MIT",
  "homepage": "./",
  "scripts": {
    "start": "cross-env HOST=127.0.0.1 PORT=3003 BROWSER=none react-scripts start",
    "build": "react-scripts build",
    "serve": "serve -s build -l 3003",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=__tests__/unit",
    "test:integration": "jest --testPathPattern=__tests__/integration"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "dexie": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-toastify": "^11.0.5",
    "workbox-webpack-plugin": "^7.4.0",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "cross-env": "^7.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react-scripts": "5.0.1",
    "serve": "^14.2.5"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
